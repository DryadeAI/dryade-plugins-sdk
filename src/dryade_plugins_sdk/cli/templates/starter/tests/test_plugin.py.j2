"""Tests for {{ name }} plugin.

These scaffolded tests are MEANINGFUL — every assertion exercises real
contract surface (Plugin Protocol conformance, manifest validation,
lifecycle hooks). No placeholder no-op bodies.

Imports are resolved by prepending the plugin root to ``sys.path`` so the
suite runs straight after ``dryade plugin new`` without an explicit
``pip install -e .``. The host loader uses the same flat-layout convention.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(PLUGIN_ROOT))

import pytest  # noqa: E402
from dryade_plugins_sdk import ManifestV2, Plugin  # noqa: E402
from dryade_plugins_sdk.testing import FakeHost  # noqa: E402

from plugin import plugin  # noqa: E402  -- the plugin module is at PLUGIN_ROOT/plugin.py


def test_plugin_satisfies_protocol():
    """{{ name }} must structurally satisfy dryade_plugins_sdk.Plugin Protocol."""
    assert isinstance(plugin, Plugin), (
        f"{type(plugin).__name__} does not satisfy Plugin Protocol — "
        f"check required attributes (name, version, description, "
        f"core_version_constraint) and methods (register, startup, shutdown, "
        f"get_health_checks, get_manageable_components)."
    )


def test_plugin_metadata():
    """Required Plugin attributes must be present and well-formed."""
    assert plugin.name == "{{ name }}"
    assert plugin.version == "0.1.0"
    assert plugin.description == "{{ description }}"
    assert plugin.core_version_constraint.startswith(">=")


def test_manifest_validates_against_v2_schema():
    """The plugin's dryade.json must validate against the v2 schema."""
    manifest_path = PLUGIN_ROOT / "dryade.json"
    assert manifest_path.exists(), "dryade.json missing from plugin root"
    data = json.loads(manifest_path.read_text())
    # ManifestV2 raises ManifestValidationError if anything is off.
    known_fields = ManifestV2.__dataclass_fields__
    manifest = ManifestV2(**{k: v for k, v in data.items() if k in known_fields})
    assert manifest.manifest_version == "2.0"
    assert manifest.required_tier == "{{ tier }}"


def test_plugin_register_is_callable():
    """register() must accept a host registry without raising."""
    host = FakeHost()
    plugin.register(host.registry)
    # The starter scaffold registers nothing by default — the assertion is
    # that the lifecycle hook is wired correctly. Customize once you add agents
    # or tools.
    assert host.registry is not None


def test_plugin_full_lifecycle():
    """register → startup → shutdown must complete without exceptions."""
    host = FakeHost()
    host.load(plugin)
    assert plugin in host.loaded
    host.shutdown()
    assert plugin not in host.loaded


def test_plugin_health_checks_shape():
    """get_health_checks() must return a mapping (possibly empty)."""
    hc = plugin.get_health_checks()
    assert hasattr(hc, "items"), "get_health_checks must return a Mapping"


def test_plugin_manageable_components_iterable():
    """get_manageable_components() must return an iterable (possibly empty)."""
    mc = plugin.get_manageable_components()
    assert hasattr(mc, "__iter__"), "get_manageable_components must return an Iterable"
