class {{ class_name }}Plugin:
    """{{ description }}

    Declared permissions: database, network. The plugin loader will only grant
    these capabilities if the user's tier and the signed allowlist permit them.

    Sandbox: the plugin ships a sandbox_policy reference (sandbox.yaml) for the
    Leash runtime to enforce process / filesystem / network isolation.
    """

    name = "{{ name }}"
    version = "0.1.0"
    description = "{{ description }}"
    core_version_constraint = "{{ core_version_constraint | default('>=1.0.0') }}"

    def __init__(self) -> None:
        self._leash: Leash | None = None

    def register(self, registry: Any) -> None:
        """Register tools with the host."""
        registry.register(example_lookup)

    def startup(self, **kwargs: Any) -> None:
        """Pick up the host-injected Leash (if available) for sandbox-aware runs."""
        leash = kwargs.get("leash")
        if leash is not None and isinstance(leash, Leash):
            self._leash = leash

    def shutdown(self) -> None:
        """Release Leash reference on shutdown."""
        self._leash = None

    def required_isolation(self) -> IsolationLevel:
        """Declare the minimum isolation this plugin needs.

        The host MAY upgrade to a stricter level (e.g. CONTAINER) based on the
        signed allowlist; the plugin must always run at or above this level.
        """
        return IsolationLevel.PROCESS

